scalar Time
# New Taiwan Dollar — whole NT$ integer (e.g. 450 = NT$450)
scalar TWD

# ─── Queries ──────────────────────────────────────────────────────────────────

type Query {
  me: User
  # Everything stored about the signed-in user, as one JSON document (#270):
  # account, active sessions, comments, saved coffees, followed shops, reports
  # filed, account events and, for a seller, the shop with its coffees and
  # options. No password or token material. UNAUTHENTICATED when signed out;
  # rate limited per account (RATE_LIMIT_EXPORT_USER).
  myDataExport: String!

  # Shop discovery
  shop(slug: String!): Shop
  # sort defaults to NEWEST. search: keywords (≤ 100 characters, ≤ 8 words);
  # every word must appear in the shop's name or description. Case-insensitive;
  # blank is ignored. Only shops with at least one published coffee are listed
  # (#213); a new shop appears with its first published coffee.
  shops(city: String, search: String, sort: ShopSort, limit: Int, offset: Int): ShopConnection!
  # Shops with at least one published coffee, at most 2000 (#213).
  shopsForMap: [ShopPin!]!

  # Coffee browsing
  coffee(id: ID!): Coffee
  # sort defaults to NEWEST.
  coffees(filter: CoffeeFilter, sort: CoffeeSort, limit: Int, offset: Int): CoffeeConnection!
  popularCoffees(limit: Int): [Coffee!]!
  # Published coffees from the shops the signed-in user follows, newest first.
  # UNAUTHENTICATED when signed out. limit defaults to 20 (max 100).
  followingCoffees(limit: Int, offset: Int): CoffeeConnection!

  # Curated dropdown data
  originCountries: [OriginCountry!]!
  coffeeVarieties: [CoffeeVariety!]!
  processingMethods: [ProcessingMethod!]!

  # How the coffee keyword search reads q (#269, #274): one list per word, the
  # word first, then its traditional-character form and synonyms (耶加雪菲 for
  # Yirgacheffe). Same validation as CoffeeFilter.search; blank gives [].
  searchTerms(q: String!): [[String!]!]!

  # Moderation (#224). Admin only: UNAUTHENTICATED when signed out, FORBIDDEN
  # for everyone else. The role is checked against the database on every call,
  # so a revoked admin loses access at once. search: every word must appear in
  # the email or display name (users) / name or slug (shops). Suspended and
  # empty shops are listed too. limit defaults to 20 (max 100).
  adminUsers(search: String, limit: Int, offset: Int): UserConnection!
  adminShops(search: String, limit: Int, offset: Int): ShopConnection!
  # Newest first.
  auditLog(limit: Int, offset: Int): AuditEntryConnection!
  # Reports from visitors (#225), newest first. status defaults to OPEN.
  # Admin only, like adminUsers.
  reports(status: ReportStatus, limit: Int, offset: Int): ReportConnection!
}

# ─── Mutations ────────────────────────────────────────────────────────────────

type Mutation {
  # Auth
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  refreshToken(token: String!): AuthPayload!
  # With refreshToken: ends only that session (this device). The token's
  # signature is checked, no access token is needed, and an unknown or already
  # ended session still returns true. Without it: requires sign-in and ends
  # every session, like logoutEverywhere.
  logout(refreshToken: String): Boolean!
  # Ends every session of the signed-in user (all refresh tokens revoked).
  # Access tokens already issued can still read until they expire (≤ 15 min)
  # but are refused for every mutation at once (#224).
  logoutEverywhere: Boolean!

  # Account (signed in)
  updateProfile(input: UpdateProfileInput!): User!
  # Checks currentPassword, stores the new one and ends every other session
  # (all refresh tokens are revoked); returns fresh tokens for this one.
  changePassword(input: ChangePasswordInput!): AuthPayload!
  # Permanently deletes the signed-in account after re-checking its password:
  # the user, their comments, saved coffees and every session. Accounts that
  # own a shop (and admins) are refused with FORBIDDEN. Access tokens already
  # issued expire within 15 minutes and are refused wherever the account is needed.
  deleteAccount(password: String!): Boolean!

  # Shop management (seller)
  createShop(input: CreateShopInput!): Shop!
  updateShop(id: ID!, input: UpdateShopInput!): Shop!
  # Sets the order of the shop's coffees on its page (Shop.coffees with
  # SHOP_ORDER). coffeeIds must list every coffee of the shop, drafts
  # included, each once; anything else is BAD_USER_INPUT (field coffeeIds).
  # Owner or admin only. New and duplicated coffees join at the end.
  reorderShopCoffees(shopId: ID!, coffeeIds: [ID!]!): Shop!

  # Coffee listings (seller)
  createCoffee(input: CreateCoffeeInput!): Coffee!
  updateCoffee(id: ID!, input: UpdateCoffeeInput!): Coffee!
  publishCoffee(id: ID!): Coffee!
  unpublishCoffee(id: ID!): Coffee!
  # Drafts only: a published coffee must be unpublished first, so public links
  # never vanish silently. Variants and comments are deleted with it.
  deleteCoffee(id: ID!): Boolean!
  # Copies a coffee you own into a new draft: details, flavour notes and options
  # (with price, stock and availability). Photos and comments are not copied.
  # name defaults to the original name + " (copy)".
  duplicateCoffee(id: ID!, name: String): Coffee!

  # Image uploads (seller). Returns a short-lived presigned PUT URL; after the
  # PUT succeeds, save publicUrl via updateShop (logoUrl / bannerUrl) or
  # updateCoffee (imageUrls). Only URLs from this mutation are accepted there.
  createImageUpload(input: ImageUploadInput!): ImageUpload!

  # Variants (seller). Grind and weight are fixed once created — delete and
  # re-add to change them. The last variant of a published coffee can't be deleted.
  addVariant(coffeeId: ID!, input: VariantInput!): Variant!
  updateVariant(id: ID!, input: UpdateVariantInput!): Variant!
  deleteVariant(id: ID!): Boolean!

  # Comments (buyer)
  addComment(input: AddCommentInput!): Comment!
  # Author only (admins can delete but not rewrite). Same body rules and rate
  # limit as addComment; the coffee must still be published. Unchanged text
  # returns the comment as it is, without setting editedAt.
  updateComment(id: ID!, body: String!): Comment!
  # The author, or an admin. An admin deleting someone else's comment is
  # recorded in the audit log with reason (≤ 500 characters).
  deleteComment(id: ID!, reason: String): Boolean!

  # Saved coffees (signed in). Only published coffees can be saved (a draft is
  # NOT_FOUND). Unsaving works whatever the coffee's state, and returns null
  # when the coffee is gone or is a draft the viewer can't see. Both are
  # idempotent and return the coffee with its new isSaved / saveCount.
  saveCoffee(id: ID!): Coffee!
  unsaveCoffee(id: ID!): Coffee

  # Followed shops (signed in). Following your own shop is BAD_USER_INPUT; an
  # unknown shop is NOT_FOUND. Unfollowing returns null when the shop is gone.
  # Both are idempotent and return the shop with its new isFollowed /
  # followerCount.
  followShop(id: ID!): Shop!
  unfollowShop(id: ID!): Shop

  # Moderation (#224). Admin only (checked against the database). Each needs a
  # reason (1–500 characters) and writes an audit-log entry in the same
  # transaction. Suspending a user ends every session at once (their access
  # tokens stop working for writes) and hides their comments; a suspended shop
  # and its coffees disappear from every public page, the sitemap and the map.
  # Admins can't suspend themselves or another admin. Repeating an action
  # (suspending a suspended user) is BAD_USER_INPUT.
  suspendUser(id: ID!, reason: String!): User!
  unsuspendUser(id: ID!, reason: String!): User!
  suspendShop(id: ID!, reason: String!): Shop!
  unsuspendShop(id: ID!, reason: String!): Shop!
  adminUnpublishCoffee(id: ID!, reason: String!): Coffee!

  # Report a comment, shop or coffee to the admins (#225). Signed in only
  # (UNAUTHENTICATED otherwise); 10 an hour per account (RATE_LIMITED). A
  # target that doesn't exist or that the viewer can't see is NOT_FOUND. note is
  # optional, at most 500 characters. Reporting the same target again while
  # the first report is still open changes nothing and returns true.
  report(targetType: ReportTargetType!, targetId: ID!, reason: ReportReason!, note: String): Boolean!
  # Closes a report and every other open report on the same target, and writes
  # an audit-log entry (DISMISS_REPORT or ACTION_REPORT). REMOVE also takes the
  # target down in the same transaction: a comment is deleted, a coffee
  # unpublished, a shop suspended (each with its own audit entry), and then
  # needs a reason (1–500 characters); for DISMISS and ACTIONED it is optional.
  # Admin only. A report that is already closed is BAD_USER_INPUT.
  resolveReport(id: ID!, action: ReportResolution!, reason: String): Report!

  # Stage 2: cart, orders, ECPay checkout — parked
}

# ─── User ─────────────────────────────────────────────────────────────────────

type User {
  id: ID!
  # Only visible to the user themself and to admins; null for everyone else.
  email: String
  displayName: String!
  role: UserRole!
  shop: Shop
  # The user's own comments, newest first. Only for the user themself or an
  # admin; for anyone else it is empty (never an error: User appears on every
  # comment).
  comments(limit: Int, offset: Int): CommentConnection!
  # Published coffees the user saved, most recently saved first (coffees moved
  # back to draft are hidden). Same visibility as comments: the user themself or
  # an admin; empty for anyone else. limit defaults to 20 (max 100).
  savedCoffees(limit: Int, offset: Int): CoffeeConnection!
  # Shops the user follows, most recently followed first. Same visibility as
  # savedCoffees. limit defaults to 20 (max 100).
  followedShops(limit: Int, offset: Int): ShopConnection!
  # An admin suspended the account (#224). Only the user themself and admins
  # see true; everyone else gets false.
  suspended: Boolean!
  createdAt: Time!
}

type UserConnection {
  nodes: [User!]!
  total: Int!
}

# ─── Moderation (#224) ────────────────────────────────────────────────────────

enum AuditAction {
  SUSPEND_USER
  UNSUSPEND_USER
  SUSPEND_SHOP
  UNSUSPEND_SHOP
  UNPUBLISH_COFFEE
  DELETE_COMMENT
  DELETE_ACCOUNT
  CHANGE_PASSWORD
  GRANT_ADMIN
  REVOKE_ADMIN
  # A report was closed (#225): dismissed, or acted on.
  DISMISS_REPORT
  ACTION_REPORT
}

enum AuditTargetType {
  USER
  SHOP
  COFFEE
  COMMENT
}

type AuditEntry {
  id: ID!
  # Who did it: null for the admin CLI, or when that account was deleted.
  actor: User
  action: AuditAction!
  targetType: AuditTargetType!
  targetId: ID!
  reason: String!
  createdAt: Time!
}

type AuditEntryConnection {
  nodes: [AuditEntry!]!
  total: Int!
}

# ─── Reports (#225) ───────────────────────────────────────────────────────────

enum ReportTargetType {
  COMMENT
  SHOP
  COFFEE
}

enum ReportReason {
  SPAM
  # Phone numbers, LINE IDs, links: taking the sale off the site.
  CONTACT_INFO
  OFFENSIVE
  # Wrong or misleading listing (origin, process, price, …).
  MISLEADING
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ReportResolution {
  # Nothing wrong: the report is DISMISSED.
  DISMISS
  # Already handled another way (e.g. the user was suspended): ACTIONED.
  ACTIONED
  # Delete the comment / unpublish the coffee / suspend the shop: ACTIONED.
  REMOVE
}

type Report {
  id: ID!
  # null once the reporter's account is deleted.
  reporter: User
  targetType: ReportTargetType!
  targetId: ID!
  # The reported thing as it is now (the one matching targetType); null when
  # it has been deleted since.
  comment: Comment
  shop: Shop
  coffee: Coffee
  reason: ReportReason!
  note: String!
  status: ReportStatus!
  # The admin who closed it; null while open (or once that account is gone).
  handledBy: User
  handledAt: Time
  createdAt: Time!
}

type ReportConnection {
  nodes: [Report!]!
  total: Int!
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

# ─── Shop ─────────────────────────────────────────────────────────────────────

type Shop {
  id: ID!
  slug: String!
  name: String!
  description: String!
  logoUrl: String
  bannerUrl: String
  city: String!
  lat: Float
  lng: Float
  # sort defaults to SHOP_ORDER, the seller's lineup (other orders as in
  # Query.coffees). filter is validated like Query.coffees' and narrows this
  # shop's coffees; the owner (and admins) also get drafts.
  coffees(filter: CoffeeFilter, sort: CoffeeSort, limit: Int, offset: Int): CoffeeConnection!
  # Published coffees only (drafts are never counted, even for the owner).
  coffeeCount: Int!
  # Newest-first comments on all of this shop's coffees (drafts included).
  # Only the shop's owner or an admin: UNAUTHENTICATED when signed out,
  # FORBIDDEN for anyone else.
  recentComments(limit: Int, offset: Int): CommentConnection!
  # Whether the signed-in viewer follows this shop; false when signed out.
  isFollowed: Boolean!
  # How many people follow it.
  followerCount: Int!
  # An admin took the shop off the site (#224): it and its coffees are hidden
  # from every public page. Only the owner and admins see true (the dashboard
  # shows a notice); nobody else can reach a suspended shop.
  suspended: Boolean!
  createdAt: Time!
  # Last change to the shop's profile.
  updatedAt: Time!
}

# MOST_COFFEES counts published coffees (Shop.coffeeCount), MOST_FOLLOWED
# counts followers (Shop.followerCount). Ties go newest first.
enum ShopSort {
  NEWEST
  NAME
  MOST_COFFEES
  MOST_FOLLOWED
}

type ShopConnection {
  nodes: [Shop!]!
  total: Int!
}

# Lightweight type for the map page (all shops, minimal fields)
type ShopPin {
  id: ID!
  slug: String!
  name: String!
  city: String!
  lat: Float
  lng: Float
}

# ─── Coffee ───────────────────────────────────────────────────────────────────

type Coffee {
  id: ID!
  shop: Shop!
  name: String!
  slug: String!
  description: String!
  originCountry: OriginCountry!
  variety: CoffeeVariety
  processingMethod: ProcessingMethod!
  # null when the seller didn't say (optional since #176).
  roastLevel: RoastLevel
  flavorNotes: [String!]!
  # Provenance: the farm, estate, cooperative or washing station, and the
  # region inside the origin country. "" when not given.
  producer: String!
  region: String!
  # Growing altitude in metres: one height (altitudeMinM only) or a range.
  # Both null when not given.
  altitudeMinM: Int
  altitudeMaxM: Int
  # What the coffee is roasted for; null when not given.
  brewMethod: BrewMethod
  # The crop (產季): the year its harvest ended; null when not given.
  harvestYear: Int
  imageUrls: [String!]!
  variants: [Variant!]!
  # Newest first. limit defaults to 20 (max 100); page with offset and use
  # commentCount for the full total.
  comments(limit: Int, offset: Int): [Comment!]!
  commentCount: Int!
  # Published coffees from other shops that resemble this one: same origin,
  # process, roast and shared flavour notes (origin weighs most; a shared roast
  # alone doesn't count). In-stock first, then most similar, then newest.
  # limit defaults to 4 (max 12).
  similar(limit: Int): [Coffee!]!
  # Whether the signed-in viewer saved this coffee; false when signed out.
  isSaved: Boolean!
  # How many people saved it.
  saveCount: Int!
  isPublished: Boolean!
  createdAt: Time!
  # Last change to the coffee or any of its options (price, stock, …).
  updatedAt: Time!
}

# Price sorts use each coffee's lowest available, in-stock variant price;
# sold-out coffees come last either way. MOST_DISCUSSED counts comments,
# MOST_SAVED counts saves (Coffee.saveCount). Ties go newest first.
# SHOP_ORDER is the seller's lineup (reorderShopCoffees); it's the default for
# Shop.coffees and only meaningful within one shop.
enum CoffeeSort {
  NEWEST
  PRICE_ASC
  PRICE_DESC
  MOST_DISCUSSED
  MOST_SAVED
  SHOP_ORDER
}

type CoffeeConnection {
  nodes: [Coffee!]!
  total: Int!
}

type Variant {
  id: ID!
  grind: GrindOption!
  weightG: Int!
  priceTwd: TWD!
  stock: Int!
  isAvailable: Boolean!
  "Last change to price, stock or availability (#278)."
  updatedAt: Time!
}

# EXTRA_LIGHT (極淺焙) was added on the owner's answer to #176.
enum RoastLevel {
  EXTRA_LIGHT
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

# What a coffee is roasted for: filter (手沖, pour-over / batch brew),
# espresso (義式) or omni (both). Independent of the roast level.
enum BrewMethod {
  FILTER
  ESPRESSO
  OMNI
}

enum GrindOption {
  WHOLE_BEAN
  COARSE
  MEDIUM
  FINE
  ESPRESSO
}

# ─── Image uploads ────────────────────────────────────────────────────────────

enum ImageKind {
  SHOP_LOGO
  SHOP_BANNER
  COFFEE_PHOTO
}

type ImageUpload {
  # PUT the file here, with exactly the headers below, within 10 minutes.
  uploadUrl: String!
  publicUrl: String!
  headers: [UploadHeader!]!
  expiresAt: Time!
  # Present when the input asked for a thumbnail: PUT the 640 px WebP there the
  # same way. Its URL is derived from publicUrl and is never saved anywhere.
  thumbnail: ImageUpload
}

type UploadHeader {
  name: String!
  value: String!
}

# ─── Reference / curated dropdowns ───────────────────────────────────────────

type OriginCountry {
  id: ID!
  nameEn: String!
  nameZh: String!
  region: String!
  "Published coffees from this country (drafts never count)."
  coffeeCount: Int!
}

type CoffeeVariety {
  id: ID!
  name: String!
  description: String
  "Published coffees of this variety (drafts never count)."
  coffeeCount: Int!
}

type ProcessingMethod {
  id: ID!
  nameEn: String!
  nameZh: String!
  description: String
  "Published coffees with this process (drafts never count)."
  coffeeCount: Int!
}

# ─── Comments ─────────────────────────────────────────────────────────────────

type Comment {
  id: ID!
  user: User!
  body: String!
  # The coffee commented on; null when the viewer can't see it (a draft of
  # someone else's shop).
  coffee: Coffee
  createdAt: Time!
  # Set when the author last changed the text; null if never edited.
  editedAt: Time
  # True when the author owns the shop selling this coffee (the roaster
  # answering). Follows current ownership; not stored with the comment.
  fromShop: Boolean!
}

type CommentConnection {
  nodes: [Comment!]!
  total: Int!
}

# ─── Auth ─────────────────────────────────────────────────────────────────────

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  user: User!
}

# ─── Inputs ───────────────────────────────────────────────────────────────────

input RegisterInput {
  email: String!
  password: String!
  displayName: String!
}

input LoginInput {
  email: String!
  password: String!
}

input UpdateProfileInput {
  displayName: String!
}

input ChangePasswordInput {
  currentPassword: String!
  newPassword: String!
}

input CreateShopInput {
  slug: String!
  name: String!
  description: String!
  city: String!
}

input UpdateShopInput {
  name: String
  description: String
  # From createImageUpload for this shop; "" removes the image.
  logoUrl: String
  bannerUrl: String
  city: String
  lat: Float
  lng: Float
}

# Required (owner's answer on #176): name, origin, process, variety, at least
# one flavour note, producer, region, altitude (at least the lowest) and an
# option. Variety, producer, region and altitude are nullable here so a
# missing one is BAD_USER_INPUT with its `field`, like the other checks.
input CreateCoffeeInput {
  name: String!
  description: String!
  originCountryId: ID!
  # Required; "Heirloom" and "Landrace" cover lots without a named cultivar.
  varietyId: ID
  processingMethodId: ID!
  # Optional (owner, #176).
  roastLevel: RoastLevel
  # At least one non-blank note (#181); ≤ 10 notes, ≤ 30 characters each.
  flavorNotes: [String!]
  # Required, 1–100 characters each.
  producer: String
  region: String
  # Metres, 0–6000; altitudeMinM required. altitudeMaxM needs altitudeMinM
  # and must be ≥ it (omitted = a single height).
  altitudeMinM: Int
  altitudeMaxM: Int
  brewMethod: BrewMethod
  # 2000 through the current year (Asia/Taipei).
  harvestYear: Int
  variants: [VariantInput!]!
}

input UpdateCoffeeInput {
  name: String
  description: String
  originCountryId: ID
  varietyId: ID
  processingMethodId: ID
  roastLevel: RoastLevel
  # true removes the roast level. Can't be combined with roastLevel.
  clearRoastLevel: Boolean
  # Omit to keep the notes; a given list needs at least one non-blank note.
  flavorNotes: [String!]
  # Required details (#176) can be changed but not removed: there is no
  # clearVariety / clearAltitude, and producer / region must be 1–100
  # characters. Coffees saved before keep whatever they have.
  producer: String
  region: String
  # Set together: giving altitudeMinM replaces both (an omitted altitudeMaxM
  # means a single height). Same rules as CreateCoffeeInput. altitudeMaxM
  # alone is BAD_USER_INPUT.
  altitudeMinM: Int
  altitudeMaxM: Int
  brewMethod: BrewMethod
  # true removes the brew method. Can't be combined with brewMethod.
  clearBrewMethod: Boolean
  # Same range as CreateCoffeeInput.
  harvestYear: Int
  # true removes the harvest year. Can't be combined with harvestYear.
  clearHarvestYear: Boolean
  # Replaces the gallery (order kept; first is the cover). At most 8 URLs, each
  # from createImageUpload for this coffee. [] removes every photo.
  imageUrls: [String!]
}

input ImageUploadInput {
  kind: ImageKind!
  # The shop ID for SHOP_LOGO / SHOP_BANNER, the coffee ID for COFFEE_PHOTO.
  targetId: ID!
  # image/jpeg, image/png or image/webp
  contentType: String!
  # Exact file size in bytes (max 5 MB); the upload must match it.
  byteSize: Int!
  # Exact size in bytes (max 512 KB) of a 640 px image/webp thumbnail to store
  # beside the original; the result's `thumbnail` is its presigned PUT. Counts
  # toward the shop's daily upload budget.
  thumbnailByteSize: Int
}

input VariantInput {
  grind: GrindOption!
  weightG: Int!
  priceTwd: Int!
  stock: Int!
}

input UpdateVariantInput {
  priceTwd: Int
  stock: Int
  isAvailable: Boolean
}

# The site's /coffees page uses only originCountryId, varietyId,
# processingMethodId, search, minPriceTwd / maxPriceTwd and inStock (owner,
# #166): each shop rates roast, brew method, harvest and altitude by its own
# standard. roastLevel, flavorNote, brewMethod, minHarvestYear and
# minAltitudeM stay for API clients, but the site doesn't use them. (The cup
# profile and its filters were removed on the owner's answer to #176.)
input CoffeeFilter {
  originCountryId: ID
  varietyId: ID
  processingMethodId: ID
  roastLevel: RoastLevel
  flavorNote: String
  # Keywords (≤ 100 characters, ≤ 8 words). Every word must appear in the
  # coffee's name, description, a flavor note, its producer, region or harvest
  # year, the shop name, or the origin / variety / process name (zh or en). Case-insensitive;
  # blank is ignored.
  search: String
  minPriceTwd: Int
  maxPriceTwd: Int
  # true: only coffees with at least one available, in-stock variant.
  # false: only coffees without one (sold out; the shop page's archive).
  # null: both.
  inStock: Boolean
  # FILTER or ESPRESSO also match OMNI coffees (they suit both); OMNI matches
  # only OMNI. Coffees without a brew method never match.
  brewMethod: BrewMethod
  # Only coffees harvested in this year or later (2000–2100). Coffees without
  # a harvest year never match.
  minHarvestYear: Int
  # Only coffees grown at or above this altitude in metres (0–6000), judged
  # by the top of the coffee's range (or its single height). Coffees without
  # an altitude never match.
  minAltitudeM: Int
}

input AddCommentInput {
  coffeeId: ID!
  body: String!
}
