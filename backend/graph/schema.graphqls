scalar Time
# New Taiwan Dollar — whole NT$ integer (e.g. 450 = NT$450)
scalar TWD

# ─── Queries ──────────────────────────────────────────────────────────────────

type Query {
  me: User

  # Shop discovery
  shop(slug: String!): Shop
  shops(city: String, limit: Int, offset: Int): ShopConnection!
  shopsForMap: [ShopPin!]!

  # Coffee browsing
  coffee(id: ID!): Coffee
  coffees(filter: CoffeeFilter, limit: Int, offset: Int): CoffeeConnection!
  popularCoffees(limit: Int): [Coffee!]!

  # Curated dropdown data
  originCountries: [OriginCountry!]!
  coffeeVarieties: [CoffeeVariety!]!
  processingMethods: [ProcessingMethod!]!
}

# ─── Mutations ────────────────────────────────────────────────────────────────

type Mutation {
  # Auth
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  refreshToken(token: String!): AuthPayload!
  logout: Boolean!

  # Shop management (seller)
  createShop(input: CreateShopInput!): Shop!
  updateShop(id: ID!, input: UpdateShopInput!): Shop!

  # Coffee listings (seller)
  createCoffee(input: CreateCoffeeInput!): Coffee!
  updateCoffee(id: ID!, input: UpdateCoffeeInput!): Coffee!
  publishCoffee(id: ID!): Coffee!
  unpublishCoffee(id: ID!): Coffee!

  # Image uploads (seller). Returns a short-lived presigned PUT URL; after the
  # PUT succeeds, save publicUrl via updateShop (logoUrl / bannerUrl) or
  # updateCoffee (imageUrls). Only URLs from this mutation are accepted there.
  createImageUpload(input: ImageUploadInput!): ImageUpload!

  # Variants (seller). Grind and weight are fixed once created — delete and
  # re-add to change them. The last variant of a published coffee can't be deleted.
  addVariant(coffeeId: ID!, input: VariantInput!): Variant!
  updateVariant(id: ID!, input: UpdateVariantInput!): Variant!
  deleteVariant(id: ID!): Boolean!

  # Comments (buyer)
  addComment(input: AddCommentInput!): Comment!
  deleteComment(id: ID!): Boolean!

  # Stage 2: cart, orders, ECPay checkout — parked
}

# ─── User ─────────────────────────────────────────────────────────────────────

type User {
  id: ID!
  # Only visible to the user themself and to admins; null for everyone else.
  email: String
  displayName: String!
  role: UserRole!
  shop: Shop
  createdAt: Time!
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

# ─── Shop ─────────────────────────────────────────────────────────────────────

type Shop {
  id: ID!
  slug: String!
  name: String!
  description: String!
  logoUrl: String
  bannerUrl: String
  city: String!
  lat: Float
  lng: Float
  coffees(limit: Int, offset: Int): CoffeeConnection!
  createdAt: Time!
}

type ShopConnection {
  nodes: [Shop!]!
  total: Int!
}

# Lightweight type for the map page (all shops, minimal fields)
type ShopPin {
  id: ID!
  slug: String!
  name: String!
  city: String!
  lat: Float
  lng: Float
}

# ─── Coffee ───────────────────────────────────────────────────────────────────

type Coffee {
  id: ID!
  shop: Shop!
  name: String!
  slug: String!
  description: String!
  originCountry: OriginCountry!
  variety: CoffeeVariety
  processingMethod: ProcessingMethod!
  roastLevel: RoastLevel!
  flavorNotes: [String!]!
  imageUrls: [String!]!
  variants: [Variant!]!
  # Newest first, capped at 100. Use commentCount for the full total.
  comments: [Comment!]!
  commentCount: Int!
  isPublished: Boolean!
  createdAt: Time!
}

type CoffeeConnection {
  nodes: [Coffee!]!
  total: Int!
}

type Variant {
  id: ID!
  grind: GrindOption!
  weightG: Int!
  priceTwd: TWD!
  stock: Int!
  isAvailable: Boolean!
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

enum GrindOption {
  WHOLE_BEAN
  COARSE
  MEDIUM
  FINE
  ESPRESSO
}

# ─── Image uploads ────────────────────────────────────────────────────────────

enum ImageKind {
  SHOP_LOGO
  SHOP_BANNER
  COFFEE_PHOTO
}

type ImageUpload {
  # PUT the file here, with exactly the headers below, within 10 minutes.
  uploadUrl: String!
  publicUrl: String!
  headers: [UploadHeader!]!
  expiresAt: Time!
}

type UploadHeader {
  name: String!
  value: String!
}

# ─── Reference / curated dropdowns ───────────────────────────────────────────

type OriginCountry {
  id: ID!
  nameEn: String!
  nameZh: String!
  region: String!
}

type CoffeeVariety {
  id: ID!
  name: String!
  description: String
}

type ProcessingMethod {
  id: ID!
  nameEn: String!
  nameZh: String!
  description: String
}

# ─── Comments ─────────────────────────────────────────────────────────────────

type Comment {
  id: ID!
  user: User!
  body: String!
  createdAt: Time!
}

# ─── Auth ─────────────────────────────────────────────────────────────────────

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  user: User!
}

# ─── Inputs ───────────────────────────────────────────────────────────────────

input RegisterInput {
  email: String!
  password: String!
  displayName: String!
}

input LoginInput {
  email: String!
  password: String!
}

input CreateShopInput {
  slug: String!
  name: String!
  description: String!
  city: String!
}

input UpdateShopInput {
  name: String
  description: String
  # From createImageUpload for this shop; "" removes the image.
  logoUrl: String
  bannerUrl: String
  city: String
  lat: Float
  lng: Float
}

input CreateCoffeeInput {
  name: String!
  description: String!
  originCountryId: ID!
  varietyId: ID
  processingMethodId: ID!
  roastLevel: RoastLevel!
  flavorNotes: [String!]
  variants: [VariantInput!]!
}

input UpdateCoffeeInput {
  name: String
  description: String
  originCountryId: ID
  varietyId: ID
  processingMethodId: ID
  roastLevel: RoastLevel
  flavorNotes: [String!]
  # true removes the variety (it's optional). Can't be combined with varietyId.
  clearVariety: Boolean
  # Replaces the gallery (order kept; first is the cover). At most 8 URLs, each
  # from createImageUpload for this coffee. [] removes every photo.
  imageUrls: [String!]
}

input ImageUploadInput {
  kind: ImageKind!
  # The shop ID for SHOP_LOGO / SHOP_BANNER, the coffee ID for COFFEE_PHOTO.
  targetId: ID!
  # image/jpeg, image/png or image/webp
  contentType: String!
  # Exact file size in bytes (max 5 MB); the upload must match it.
  byteSize: Int!
}

input VariantInput {
  grind: GrindOption!
  weightG: Int!
  priceTwd: Int!
  stock: Int!
}

input UpdateVariantInput {
  priceTwd: Int
  stock: Int
  isAvailable: Boolean
}

input CoffeeFilter {
  originCountryId: ID
  varietyId: ID
  processingMethodId: ID
  roastLevel: RoastLevel
  flavorNote: String
  minPriceTwd: Int
  maxPriceTwd: Int
}

input AddCommentInput {
  coffeeId: ID!
  body: String!
}
