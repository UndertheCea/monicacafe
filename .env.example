# Moni Cafe — environment variables.
# Copy to `.env` (git-ignored) and adjust. Every value here is a safe
# DEVELOPMENT default; docker-compose.yml falls back to the same values when
# .env is absent, so `docker compose up` works without this file.
#
# NEVER commit a real .env.
#
# REPLACE BEFORE PRODUCTION: every value marked [REPLACE] below is published in
# this repository, so anyone can read it. With APP_ENV=production the backend
# refuses to start while any of them is still in use (or looks like a
# placeholder: contains "dev-" or "change"). Both JWT secrets must also be ≥32
# characters and different. Generate each with: openssl rand -base64 48

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=monica
# [REPLACE] in production.
POSTGRES_PASSWORD=monica_secret
POSTGRES_DB=monicacafe
# Load scripts/seed_dev.sql on first start of an empty volume (true/false).
# Must be false with APP_ENV=production: initdb.sh refuses to put fake shops
# into a production database and stops.
SEED_DEMO_DATA=true
# Migrations (#209): compose's `migrate` service applies any migrations/NNN_*.sql
# the database hasn't recorded (table schema_migrations) on every start. A
# volume created before that table existed is refused once; if it was created
# with migrations up to NNN, set MIGRATE_BASELINE=NNN for one `docker compose up`
# to record 001–NNN without re-running them (then empty it again).
MIGRATE_BASELINE=
# DEV ONLY, never production: also load scripts/seed_reference.sql, shops that
# mirror reference roasters' coffee lists to find origins / varieties /
# processes our dropdowns lack (#169). Remove with scripts/remove_reference_shops.sql.
SEED_REFERENCE_SHOPS=false

# --- Backend (Go API, read by config.Load()) ---------------------------------
# Required: development, test or production. The API refuses to start when it
# is unset or anything else. Only "production" enforces the secret checks and
# turns off GraphQL introspection and /playground.
APP_ENV=development
LOCALE=zh-TW
# Only used when running the backend outside compose (`go run ./cmd/server`);
# inside compose DATABASE_URL is built from the POSTGRES_* values above.
DATABASE_URL=postgres://monica:monica_secret@localhost:5432/monicacafe
# Reserved (nothing reads REDIS_URL / MEILI_* yet; both are optional). The services
# only start under compose profiles: `docker compose --profile cache --profile search up`.
REDIS_URL=
# [REPLACE] both in production. Whoever knows the access secret can sign an
# admin token.
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
# Postgres pool: max open connections per API instance, and the statement_timeout
# sent on every connection (Go duration, ≥1s; 0 = none). Both override the DSN.
DB_MAX_CONNS=10
DB_STATEMENT_TIMEOUT=10s
# How often the API deletes expired refresh tokens (Go duration, ≥1m; 0 = off).
TOKEN_PRUNE_INTERVAL=1h
# Proxies (CIDRs / IPs, comma-separated) whose X-Forwarded-For is believed when
# working out the client IP: loopback and the compose network (COMPOSE_SUBNET),
# i.e. nginx and the Next server. In production list only your load balancer /
# nginx / frontend, and don't expose the backend or the frontend port directly:
# anything trusted can claim any client IP. (Run outside compose, the API's
# built-in default also trusts every private range.)
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.30.89.0/24
# Auth rate limits, "N/duration": burst N, refilled over duration (0 = off).
# Exceeding one returns RATE_LIMITED (HTTP 429 from /api/auth/*). In memory, per
# API instance. LOGIN_EMAIL / LOGIN_EMAIL_IP count only failed passwords (unknown
# emails too, so the limit doesn't reveal which accounts exist): per account
# across all addresses, and per account + address (IPv6 by its /64), so one
# address can't lock the owner out (#213).
RATE_LIMIT_LOGIN_IP=20/1m
RATE_LIMIT_LOGIN_EMAIL=50/10m
RATE_LIMIT_LOGIN_EMAIL_IP=10/10m
RATE_LIMIT_REGISTER_IP=10/1h
RATE_LIMIT_REFRESH_IP=60/1m
# Per signed-in account: comments posted, and presigned image uploads requested.
RATE_LIMIT_COMMENT_USER=5/5m
RATE_LIMIT_UPLOAD_USER=30/10m
# Bytes of images one shop may presign per rolling 24 hours (declared sizes;
# default 200 MiB, 0 = no budget). Over it, createImageUpload says UPLOAD_QUOTA.
UPLOAD_DAILY_BYTES_PER_SHOP=209715200
# changePassword attempts per account (each checks the current password).
RATE_LIMIT_PASSWORD_USER=5/15m
# saveCoffee / unsaveCoffee calls per account.
RATE_LIMIT_SAVE_USER=60/5m
# Cart writes (add / change / remove) per account (#21).
RATE_LIMIT_CART_USER=120/5m
# Reports filed per account (report a comment, shop or coffee), #225.
RATE_LIMIT_REPORT_USER=10/1h
# Shop / coffee / option writes per account (create, update, publish, reorder,
# duplicate, delete), #213. A shop also holds at most 200 coffees.
RATE_LIMIT_SELLER_WRITE_USER=60/5m
# "Download my data" exports per account (#270); each reads everything the account holds.
RATE_LIMIT_EXPORT_USER=10/1h
# Every /graphql request per client IP, queries included (#207); answered with
# HTTP 429 + RATE_LIMITED. One page view makes 1–3 requests, and the Next.js
# server passes the visitor's address on, so visitors don't share a budget.
# Query size is capped separately: depth 8, cost 8000, 5000 tokens, 100 KB body.
RATE_LIMIT_GRAPHQL_IP=600/1m
# Observability (#221). Prometheus /metrics is served on its own port, never by
# nginx: compose sets ":9100" (compose network only, not published). Empty
# disables it; the default outside compose binds loopback only. A scraper must
# reach that port directly, and must not be exposed to the internet.
METRICS_ADDR=:9100
# Sentry-compatible error reporting (Sentry, GlitchTip, ...): panics and
# internal GraphQL errors from the API, and server-side render errors from the
# Next.js server. Empty = off. Events carry no emails, tokens or request
# bodies. SENTRY_RELEASE tags them with a build id (e.g. the git SHA).
SENTRY_DSN=
SENTRY_RELEASE=
# Comma-separated list of browser origins allowed to call /graphql.
CORS_ORIGIN=http://localhost,http://localhost:3000

# --- Image storage (S3-compatible; SeaweedFS in compose) ---------------------
# Uploads are disabled when S3_ACCESS_KEY is empty. S3_ENDPOINT is the origin
# the *browser* uploads to: presigned URLs are signed for that host. In compose
# nginx proxies /<bucket>/ on http://localhost to SeaweedFS, so uploads and image
# URLs are same-origin.
S3_ENDPOINT=http://localhost
S3_BUCKET=media
S3_REGION=us-east-1
S3_ACCESS_KEY=monica_s3
# [REPLACE] in production.
S3_SECRET_KEY=monica_s3_secret
# Where uploaded images are served from; defaults to S3_ENDPOINT/S3_BUCKET.
# Set it when a CDN fronts the bucket in production.
MEDIA_PUBLIC_URL=
# Where the API itself reaches the store to list / delete objects (it can't use
# the browser-facing S3_ENDPOINT from inside docker). Compose sets
# http://seaweedfs:8333; empty means S3_ENDPOINT.
S3_INTERNAL_ENDPOINT=
# Orphaned-image cleanup: every MEDIA_CLEANUP_INTERVAL (≥1m, 0 = off) the API
# deletes objects under shops/ and coffees/ that no shop or coffee references
# and that are older than MEDIA_CLEANUP_MIN_AGE (≥1h), at most 1000 per run.
MEDIA_CLEANUP_INTERVAL=6h
MEDIA_CLEANUP_MIN_AGE=24h

# --- Search (Stage 3, reserved, optional; compose profile `search`) ----------
MEILI_URL=
# [REPLACE] in production, and set MEILI_ENV=production, before using the profile.
MEILI_KEY=monica_meili_key
MEILI_ENV=development

# --- Backups (#220; compose service `backup`, profile `prod`; see docs/BACKUP.md) ---
# Nightly at 03:00 Taipei: pg_dump, encrypted with age, copied to S3, pruned to 7
# daily + 4 weekly. Start with `docker compose --profile prod up -d`.
# age PUBLIC key (the private key stays offline with the owner). Empty: the
# script refuses, unless BACKUP_ALLOW_PLAINTEXT is true (dev / CI drill only).
BACKUP_AGE_RECIPIENT=
BACKUP_ALLOW_PLAINTEXT=false
# A local directory (/path or file:///path) instead of S3; empty = use S3 below.
BACKUP_TARGET=
# A different bucket from S3_BUCKET (the media one), ideally another account or
# provider. Leave BACKUP_S3_ENDPOINT empty for AWS.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=monicacafe/
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Hour of the nightly run in Taipei time (0-23); BACKUP_RUN_NOW=true also runs one
# backup when the service starts, to check the setup.
BACKUP_HOUR=3
BACKUP_RUN_NOW=false

# --- Frontend (Next.js) ------------------------------------------------------
# Public origin, read at request time: sitemap.xml and robots.txt, the allowed Origin for /api/auth
# (CSRF check), and, when https://, the Secure `__Host-` refresh cookie and CSP upgrade-insecure-requests
# (so set it to the https URL users see, even when TLS ends at a load balancer).
SITE_URL=http://localhost
# The browser calls /graphql on the page's own origin (nginx forwards it), so a
# built image works on any host or port (#210); `npm run dev` without nginx uses
# http://localhost:4000/graphql. To point browsers elsewhere, set this before
# `npm run build` (it is inlined into the bundle):
# NEXT_PUBLIC_GRAPHQL_URL=https://api.example.com/graphql
# Images: compose passes MEDIA_PUBLIC_URL to the frontend as MEDIA_URL (read per
# request) so the Content-Security-Policy allows a CDN origin. Empty = same origin.
# Server-side endpoint. Compose sets http://backend:4000/graphql; for
# `npm run dev` outside docker use http://localhost:4000/graphql.
GRAPHQL_URL_INTERNAL=http://localhost:4000/graphql

# --- Network and host ports -------------------------------------------------
# The compose network's subnet; TRUSTED_PROXIES above lists it. Change both if
# it clashes with a network on the host.
COMPOSE_SUBNET=172.30.89.0/24
# Only nginx (HTTP_PORT) listens on every interface. Postgres, the API and the
# Next server are published on 127.0.0.1 only, for tools on this machine:
# reaching them directly skips nginx, which is what sets X-Real-IP.
HTTP_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
