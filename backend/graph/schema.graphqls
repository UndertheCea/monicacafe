scalar Time
# New Taiwan Dollar — whole NT$ integer (e.g. 450 = NT$450)
scalar TWD

# ─── Queries ──────────────────────────────────────────────────────────────────

type Query {
  me: User

  # Shop discovery
  shop(slug: String!): Shop
  # sort defaults to NEWEST. search: keywords (≤ 100 characters, ≤ 8 words);
  # every word must appear in the shop's name or description. Case-insensitive;
  # blank is ignored.
  shops(city: String, search: String, sort: ShopSort, limit: Int, offset: Int): ShopConnection!
  shopsForMap: [ShopPin!]!

  # Coffee browsing
  coffee(id: ID!): Coffee
  # sort defaults to NEWEST.
  coffees(filter: CoffeeFilter, sort: CoffeeSort, limit: Int, offset: Int): CoffeeConnection!
  popularCoffees(limit: Int): [Coffee!]!
  # Published coffees from the shops the signed-in user follows, newest first.
  # UNAUTHENTICATED when signed out. limit defaults to 20 (max 100).
  followingCoffees(limit: Int, offset: Int): CoffeeConnection!

  # Curated dropdown data
  originCountries: [OriginCountry!]!
  coffeeVarieties: [CoffeeVariety!]!
  processingMethods: [ProcessingMethod!]!
}

# ─── Mutations ────────────────────────────────────────────────────────────────

type Mutation {
  # Auth
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  refreshToken(token: String!): AuthPayload!
  # With refreshToken: ends only that session (this device). The token's
  # signature is checked, no access token is needed, and an unknown or already
  # ended session still returns true. Without it: requires sign-in and ends
  # every session, like logoutEverywhere.
  logout(refreshToken: String): Boolean!
  # Ends every session of the signed-in user (all refresh tokens revoked).
  # Access tokens already issued stay valid until they expire (≤ 15 min).
  logoutEverywhere: Boolean!

  # Account (signed in)
  updateProfile(input: UpdateProfileInput!): User!
  # Checks currentPassword, stores the new one and ends every other session
  # (all refresh tokens are revoked); returns fresh tokens for this one.
  changePassword(input: ChangePasswordInput!): AuthPayload!
  # Permanently deletes the signed-in account after re-checking its password:
  # the user, their comments, saved coffees and every session. Accounts that
  # own a shop (and admins) are refused with FORBIDDEN. Access tokens already
  # issued expire within 15 minutes and are refused wherever the account is needed.
  deleteAccount(password: String!): Boolean!

  # Shop management (seller)
  createShop(input: CreateShopInput!): Shop!
  updateShop(id: ID!, input: UpdateShopInput!): Shop!
  # Sets the order of the shop's coffees on its page (Shop.coffees with
  # SHOP_ORDER). coffeeIds must list every coffee of the shop, drafts
  # included, each once; anything else is BAD_USER_INPUT (field coffeeIds).
  # Owner or admin only. New and duplicated coffees join at the end.
  reorderShopCoffees(shopId: ID!, coffeeIds: [ID!]!): Shop!

  # Coffee listings (seller)
  createCoffee(input: CreateCoffeeInput!): Coffee!
  updateCoffee(id: ID!, input: UpdateCoffeeInput!): Coffee!
  publishCoffee(id: ID!): Coffee!
  unpublishCoffee(id: ID!): Coffee!
  # Drafts only: a published coffee must be unpublished first, so public links
  # never vanish silently. Variants and comments are deleted with it.
  deleteCoffee(id: ID!): Boolean!
  # Copies a coffee you own into a new draft: details, flavour notes and options
  # (with price, stock and availability). Photos and comments are not copied.
  # name defaults to the original name + " (copy)".
  duplicateCoffee(id: ID!, name: String): Coffee!

  # Image uploads (seller). Returns a short-lived presigned PUT URL; after the
  # PUT succeeds, save publicUrl via updateShop (logoUrl / bannerUrl) or
  # updateCoffee (imageUrls). Only URLs from this mutation are accepted there.
  createImageUpload(input: ImageUploadInput!): ImageUpload!

  # Variants (seller). Grind and weight are fixed once created — delete and
  # re-add to change them. The last variant of a published coffee can't be deleted.
  addVariant(coffeeId: ID!, input: VariantInput!): Variant!
  updateVariant(id: ID!, input: UpdateVariantInput!): Variant!
  deleteVariant(id: ID!): Boolean!

  # Comments (buyer)
  addComment(input: AddCommentInput!): Comment!
  # Author only (admins can delete but not rewrite). Same body rules and rate
  # limit as addComment; the coffee must still be published. Unchanged text
  # returns the comment as it is, without setting editedAt.
  updateComment(id: ID!, body: String!): Comment!
  deleteComment(id: ID!): Boolean!

  # Saved coffees (signed in). Only published coffees can be saved (a draft is
  # NOT_FOUND). Unsaving works whatever the coffee's state, and returns null
  # when the coffee is gone or is a draft the viewer can't see. Both are
  # idempotent and return the coffee with its new isSaved / saveCount.
  saveCoffee(id: ID!): Coffee!
  unsaveCoffee(id: ID!): Coffee

  # Followed shops (signed in). Following your own shop is BAD_USER_INPUT; an
  # unknown shop is NOT_FOUND. Unfollowing returns null when the shop is gone.
  # Both are idempotent and return the shop with its new isFollowed /
  # followerCount.
  followShop(id: ID!): Shop!
  unfollowShop(id: ID!): Shop

  # Stage 2: cart, orders, ECPay checkout — parked
}

# ─── User ─────────────────────────────────────────────────────────────────────

type User {
  id: ID!
  # Only visible to the user themself and to admins; null for everyone else.
  email: String
  displayName: String!
  role: UserRole!
  shop: Shop
  # The user's own comments, newest first. Only for the user themself or an
  # admin; for anyone else it is empty (never an error: User appears on every
  # comment).
  comments(limit: Int, offset: Int): CommentConnection!
  # Published coffees the user saved, most recently saved first (coffees moved
  # back to draft are hidden). Same visibility as comments: the user themself or
  # an admin; empty for anyone else. limit defaults to 20 (max 100).
  savedCoffees(limit: Int, offset: Int): CoffeeConnection!
  # Shops the user follows, most recently followed first. Same visibility as
  # savedCoffees. limit defaults to 20 (max 100).
  followedShops(limit: Int, offset: Int): ShopConnection!
  createdAt: Time!
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

# ─── Shop ─────────────────────────────────────────────────────────────────────

type Shop {
  id: ID!
  slug: String!
  name: String!
  description: String!
  logoUrl: String
  bannerUrl: String
  city: String!
  lat: Float
  lng: Float
  # sort defaults to SHOP_ORDER, the seller's lineup (other orders as in
  # Query.coffees). filter is validated like Query.coffees' and narrows this
  # shop's coffees; the owner (and admins) also get drafts.
  coffees(filter: CoffeeFilter, sort: CoffeeSort, limit: Int, offset: Int): CoffeeConnection!
  # Published coffees only (drafts are never counted, even for the owner).
  coffeeCount: Int!
  # Newest-first comments on all of this shop's coffees (drafts included).
  # Only the shop's owner or an admin: UNAUTHENTICATED when signed out,
  # FORBIDDEN for anyone else.
  recentComments(limit: Int, offset: Int): CommentConnection!
  # Whether the signed-in viewer follows this shop; false when signed out.
  isFollowed: Boolean!
  # How many people follow it.
  followerCount: Int!
  createdAt: Time!
  # Last change to the shop's profile.
  updatedAt: Time!
}

# MOST_COFFEES counts published coffees (Shop.coffeeCount), MOST_FOLLOWED
# counts followers (Shop.followerCount). Ties go newest first.
enum ShopSort {
  NEWEST
  NAME
  MOST_COFFEES
  MOST_FOLLOWED
}

type ShopConnection {
  nodes: [Shop!]!
  total: Int!
}

# Lightweight type for the map page (all shops, minimal fields)
type ShopPin {
  id: ID!
  slug: String!
  name: String!
  city: String!
  lat: Float
  lng: Float
}

# ─── Coffee ───────────────────────────────────────────────────────────────────

type Coffee {
  id: ID!
  shop: Shop!
  name: String!
  slug: String!
  description: String!
  originCountry: OriginCountry!
  variety: CoffeeVariety
  processingMethod: ProcessingMethod!
  roastLevel: RoastLevel!
  flavorNotes: [String!]!
  # Provenance: the farm, estate, cooperative or washing station, and the
  # region inside the origin country. "" when not given.
  producer: String!
  region: String!
  # Growing altitude in metres: one height (altitudeMinM only) or a range.
  # Both null when not given.
  altitudeMinM: Int
  altitudeMaxM: Int
  # What the coffee is roasted for; null when not given.
  brewMethod: BrewMethod
  # The crop (產季): the year its harvest ended; null when not given.
  harvestYear: Int
  # Cup profile (酸度 / 甜度 / 醇厚度), each 1 (low) to 5 (high); null when not
  # given. Set together through CupProfileInput.
  acidity: Int
  sweetness: Int
  body: Int
  imageUrls: [String!]!
  variants: [Variant!]!
  # Newest first. limit defaults to 20 (max 100); page with offset and use
  # commentCount for the full total.
  comments(limit: Int, offset: Int): [Comment!]!
  commentCount: Int!
  # Published coffees from other shops that resemble this one: same origin,
  # process, roast and shared flavour notes (origin weighs most; a shared roast
  # alone doesn't count). In-stock first, then most similar, then newest.
  # limit defaults to 4 (max 12).
  similar(limit: Int): [Coffee!]!
  # Whether the signed-in viewer saved this coffee; false when signed out.
  isSaved: Boolean!
  # How many people saved it.
  saveCount: Int!
  isPublished: Boolean!
  createdAt: Time!
  # Last change to the coffee or any of its options (price, stock, …).
  updatedAt: Time!
}

# Price sorts use each coffee's lowest available, in-stock variant price;
# sold-out coffees come last either way. MOST_DISCUSSED counts comments,
# MOST_SAVED counts saves (Coffee.saveCount). Ties go newest first.
# SHOP_ORDER is the seller's lineup (reorderShopCoffees); it's the default for
# Shop.coffees and only meaningful within one shop.
enum CoffeeSort {
  NEWEST
  PRICE_ASC
  PRICE_DESC
  MOST_DISCUSSED
  MOST_SAVED
  SHOP_ORDER
}

type CoffeeConnection {
  nodes: [Coffee!]!
  total: Int!
}

type Variant {
  id: ID!
  grind: GrindOption!
  weightG: Int!
  priceTwd: TWD!
  stock: Int!
  isAvailable: Boolean!
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

# What a coffee is roasted for: filter (手沖, pour-over / batch brew),
# espresso (義式) or omni (both). Independent of the roast level.
# A coffee's cup profile, each 1 (low) to 5 (high) or null (not given). At
# least one must be set; use clearCupProfile to remove the profile.
input CupProfileInput {
  acidity: Int
  sweetness: Int
  body: Int
}

enum BrewMethod {
  FILTER
  ESPRESSO
  OMNI
}

enum GrindOption {
  WHOLE_BEAN
  COARSE
  MEDIUM
  FINE
  ESPRESSO
}

# ─── Image uploads ────────────────────────────────────────────────────────────

enum ImageKind {
  SHOP_LOGO
  SHOP_BANNER
  COFFEE_PHOTO
}

type ImageUpload {
  # PUT the file here, with exactly the headers below, within 10 minutes.
  uploadUrl: String!
  publicUrl: String!
  headers: [UploadHeader!]!
  expiresAt: Time!
}

type UploadHeader {
  name: String!
  value: String!
}

# ─── Reference / curated dropdowns ───────────────────────────────────────────

type OriginCountry {
  id: ID!
  nameEn: String!
  nameZh: String!
  region: String!
  "Published coffees from this country (drafts never count)."
  coffeeCount: Int!
}

type CoffeeVariety {
  id: ID!
  name: String!
  description: String
  "Published coffees of this variety (drafts never count)."
  coffeeCount: Int!
}

type ProcessingMethod {
  id: ID!
  nameEn: String!
  nameZh: String!
  description: String
  "Published coffees with this process (drafts never count)."
  coffeeCount: Int!
}

# ─── Comments ─────────────────────────────────────────────────────────────────

type Comment {
  id: ID!
  user: User!
  body: String!
  # The coffee commented on; null when the viewer can't see it (a draft of
  # someone else's shop).
  coffee: Coffee
  createdAt: Time!
  # Set when the author last changed the text; null if never edited.
  editedAt: Time
  # True when the author owns the shop selling this coffee (the roaster
  # answering). Follows current ownership; not stored with the comment.
  fromShop: Boolean!
}

type CommentConnection {
  nodes: [Comment!]!
  total: Int!
}

# ─── Auth ─────────────────────────────────────────────────────────────────────

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  user: User!
}

# ─── Inputs ───────────────────────────────────────────────────────────────────

input RegisterInput {
  email: String!
  password: String!
  displayName: String!
}

input LoginInput {
  email: String!
  password: String!
}

input UpdateProfileInput {
  displayName: String!
}

input ChangePasswordInput {
  currentPassword: String!
  newPassword: String!
}

input CreateShopInput {
  slug: String!
  name: String!
  description: String!
  city: String!
}

input UpdateShopInput {
  name: String
  description: String
  # From createImageUpload for this shop; "" removes the image.
  logoUrl: String
  bannerUrl: String
  city: String
  lat: Float
  lng: Float
}

input CreateCoffeeInput {
  name: String!
  description: String!
  originCountryId: ID!
  varietyId: ID
  processingMethodId: ID!
  roastLevel: RoastLevel!
  flavorNotes: [String!]
  # ≤ 100 characters each; blank = not given.
  producer: String
  region: String
  # Metres, 0–6000. altitudeMaxM needs altitudeMinM and must be ≥ it.
  altitudeMinM: Int
  altitudeMaxM: Int
  brewMethod: BrewMethod
  # 2000 through the current year (Asia/Taipei).
  harvestYear: Int
  cupProfile: CupProfileInput
  variants: [VariantInput!]!
}

input UpdateCoffeeInput {
  name: String
  description: String
  originCountryId: ID
  varietyId: ID
  processingMethodId: ID
  roastLevel: RoastLevel
  flavorNotes: [String!]
  # true removes the variety (it's optional). Can't be combined with varietyId.
  clearVariety: Boolean
  # ≤ 100 characters each; "" clears.
  producer: String
  region: String
  # Set together: giving altitudeMinM replaces both (an omitted altitudeMaxM
  # means a single height). Same rules as CreateCoffeeInput. altitudeMaxM
  # alone is BAD_USER_INPUT.
  altitudeMinM: Int
  altitudeMaxM: Int
  # true removes the altitude. Can't be combined with altitudeMinM / altitudeMaxM.
  clearAltitude: Boolean
  brewMethod: BrewMethod
  # true removes the brew method. Can't be combined with brewMethod.
  clearBrewMethod: Boolean
  # Same range as CreateCoffeeInput.
  harvestYear: Int
  # true removes the harvest year. Can't be combined with harvestYear.
  clearHarvestYear: Boolean
  # Replaces all three scales (an omitted one becomes null).
  cupProfile: CupProfileInput
  # true removes the cup profile. Can't be combined with cupProfile.
  clearCupProfile: Boolean
  # Replaces the gallery (order kept; first is the cover). At most 8 URLs, each
  # from createImageUpload for this coffee. [] removes every photo.
  imageUrls: [String!]
}

input ImageUploadInput {
  kind: ImageKind!
  # The shop ID for SHOP_LOGO / SHOP_BANNER, the coffee ID for COFFEE_PHOTO.
  targetId: ID!
  # image/jpeg, image/png or image/webp
  contentType: String!
  # Exact file size in bytes (max 5 MB); the upload must match it.
  byteSize: Int!
}

input VariantInput {
  grind: GrindOption!
  weightG: Int!
  priceTwd: Int!
  stock: Int!
}

input UpdateVariantInput {
  priceTwd: Int
  stock: Int
  isAvailable: Boolean
}

# The site's /coffees page uses only originCountryId, varietyId,
# processingMethodId, search, minPriceTwd / maxPriceTwd and inStock (owner,
# #166): each shop rates roast, brew method, harvest, cup profile and altitude
# by its own standard. roastLevel, flavorNote, brewMethod, minHarvestYear,
# maxAcidity, minSweetness, minBody / maxBody and minAltitudeM stay for API
# clients, but the site doesn't use them.
input CoffeeFilter {
  originCountryId: ID
  varietyId: ID
  processingMethodId: ID
  roastLevel: RoastLevel
  flavorNote: String
  # Keywords (≤ 100 characters, ≤ 8 words). Every word must appear in the
  # coffee's name, description, a flavor note, its producer, region or harvest
  # year, the shop name, or the origin / variety / process name (zh or en). Case-insensitive;
  # blank is ignored.
  search: String
  minPriceTwd: Int
  maxPriceTwd: Int
  # true: only coffees with at least one available, in-stock variant.
  # false: only coffees without one (sold out; the shop page's archive).
  # null: both.
  inStock: Boolean
  # FILTER or ESPRESSO also match OMNI coffees (they suit both); OMNI matches
  # only OMNI. Coffees without a brew method never match.
  brewMethod: BrewMethod
  # Only coffees harvested in this year or later (2000–2100). Coffees without
  # a harvest year never match.
  minHarvestYear: Int
  # Only coffees whose acidity is this or lower (1–5). Coffees without an
  # acidity never match.
  maxAcidity: Int
  # Only coffees whose sweetness is this or higher (1–5).
  minSweetness: Int
  # Only coffees whose body is within these bounds (1–5 each; minBody must
  # not exceed maxBody). Coffees without that scale never match.
  minBody: Int
  maxBody: Int
  # Only coffees grown at or above this altitude in metres (0–6000), judged
  # by the top of the coffee's range (or its single height). Coffees without
  # an altitude never match.
  minAltitudeM: Int
}

input AddCommentInput {
  coffeeId: ID!
  body: String!
}
